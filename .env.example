# PaperBridge Local 設定サンプル
# 初期値はすべてローカルループバック（127.0.0.1）限定・テレメトリー無効・外部自動接続禁止です。

PAPERBRIDGE_HOST=127.0.0.1
PAPERBRIDGE_PORT=8080

# 実行時データの保存先（リポジトリ外のローカルAppData等を推奨。未指定時は %LOCALAPPDATA%\PaperBridgeLocal）
PAPERBRIDGE_RUNTIME_DIR=

# llama.cpp ローカルサーバー設定（ループバック限定を初期値とする）
PAPERBRIDGE_LLAMA_BASE_URL=http://127.0.0.1:8000/v1
PAPERBRIDGE_LLAMA_MODEL_ALIAS=plamo-3-translate
PAPERBRIDGE_ALLOW_EXTERNAL_TRANSLATION_HOST=false

# コンテキスト・翻訳設定
PAPERBRIDGE_CONTEXT_LENGTH=8192
PAPERBRIDGE_MODEL_MAX_LENGTH=32768
PAPERBRIDGE_CONCURRENCY=1
PAPERBRIDGE_DEFAULT_FORM=plain

# 組版設定（日本語フォントはWindowsの既定候補から自動検出します。
# PAPERBRIDGE_FONT_SERIF_PATH / PAPERBRIDGE_FONT_SANS_PATH の環境変数設定は未実装です。）
PAPERBRIDGE_MIN_FONT_SIZE_PT=8.0

# アセット・セキュリティ上限
PAPERBRIDGE_ALLOW_AUTO_ASSET_DOWNLOAD=false
PAPERBRIDGE_TELEMETRY_ENABLED=false
PAPERBRIDGE_MAX_UPLOAD_MB=100
PAPERBRIDGE_MAX_PAGES=300
PAPERBRIDGE_JOB_TIMEOUT_SEC=3600
